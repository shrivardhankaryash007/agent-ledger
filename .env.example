# Host port for the read API (FastAPI). Registered in ~/dev/standards/PORTS.md.
AGENT_LEDGER_HOST_PORT=8680

# Path to the SQLite database file.
AGENT_LEDGER_DB_PATH=data/ledger.db

# Root directory the Claude Code transcript ingester scans (rglob "*.jsonl").
# Defaults to ~/.claude/projects if unset.
AGENT_LEDGER_CLAUDE_PROJECTS_DIR=
